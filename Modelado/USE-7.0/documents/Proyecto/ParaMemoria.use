model TopFive_V1

-- =============================================================================
-- ENUMERACIONES
-- =============================================================================

enum TipoEstado { PENDIENTE, EN_CURSO, COMPLETADO }
enum TipoRecurso { LIBRO, VIDEOJUEGO, COLECCION, MUSICA, AUDIOVISUAL}
enum TipoContenido { LIBRO, VIDEOJUEGO, CANCION, ALBUM, PELICULA, SERIE}

-- =============================================================================
-- CLASES
-- =============================================================================
class Usuario
attributes
	nombreUsuario: String
	email: String
	contrasena: String
	fechaRegistro: String
end

class UsuarioAdministrador < Usuario
attributes
	dni: String
	telefono: String
end

class Contenido
attributes
	nombre: String
	genero: String
	fechaLanzamiento: String
	creador: String
	tipoContenido: TipoContenido
	creadorRecurso: UsuarioAdministrador
end

class Libro < Contenido
attributes
	saga: String
	editorial: String
	paginas: Integer -- > 0
	calificacionMedia: Real derive:
		if self.instanciaUsuario->isEmpty() then 0.0
		else self.instanciaUsuario.calificacion->sum() / self.instanciaUsuario->size()
		endif
end

class Videojuego < Contenido
attributes
	duracion: Integer 
	calificacionMedia: Real derive:
		if self.instanciaUsuario->isEmpty() then 0.0
		else self.instanciaUsuario.calificacion->sum() / self.instanciaUsuario->size()
		endif
end

class Cancion < Contenido
attributes
	duracion: Integer 
	calificacionMedia: Real derive:
		if self.instanciaUsuario->isEmpty() then 0.0
		else self.instanciaUsuario.calificacion->sum() / self.instanciaUsuario->size()
		endif
end

class Album < Contenido
attributes
	calificacionMedia: Real derive:
		if self.instanciaUsuario->isEmpty() then 0.0
		else self.instanciaUsuario.calificacion->sum() / self.instanciaUsuario->size()
		endif
end

class Pelicula < Contenido
attributes
	duracion: Integer 
	calificacionMedia: Real derive:
		if self.instanciaUsuario->isEmpty() then 0.0
		else self.instanciaUsuario.calificacion->sum() / self.instanciaUsuario->size()
		endif
end

class Serie < Contenido
attributes
	numeroTemporadas: Integer
	calificacionMedia: Real derive:
		if self.instanciaUsuario->isEmpty() then 0.0
		else self.instanciaUsuario.calificacion->sum() / self.instanciaUsuario->size()
		endif
end

-- Clase común para añadir cualquier recurso
abstract class Recurso
attributes
	calificacion: Integer
	resena: String
	estado: TipoEstado
	favorito: Boolean
	fechaCreacion: String
	tipoRecurso: TipoRecurso
end

-- Clases de recursos ESPECÍFICOS
class RecursoLibro < Recurso
attributes
	horasLeidas: Integer 
	paginasLeidas: Integer   
	fechaInicio: String
	fechaFin: String
end

class RecursoVideojuego < Recurso
attributes
	horasJugadas: Integer     
	dificultad: Integer		-- escala del 1 al 10
	fechaInicio: String
	fechaFin: String
end

class RecursoCancion < Recurso
attributes
	fechaEscucha: String
end

class RecursoAlbum < Recurso
attributes
	fechaEscucha: String
end

class RecursoPelicula < Recurso
attributes
	fechaVisionado: String
	numeroVisionados: Integer 
end

class RecursoSerie < Recurso
attributes
	temporadaActual: Integer 
	episodioActual: Integer 
	numeroVisionados: Integer 
	fechaInicio: String
	fechaFin: String
end

class RecursoColeccion < Recurso
attributes
	nombreColeccion: String
end
------ Fin de las clases -------------


------- Asociaciones -----------------
association Tiene between
	Usuario[1] role propietario
	Recurso[*] role recursos
end

association PerteneceAlbum between
	Album[0..*] role album
	Cancion[1..*] role canciones
end

association ReferenciaLibro between
    Libro[1] role libroBase
    RecursoLibro[*] role instanciaUsuario
end

association ReferenciaVideojuego between
    Videojuego[1] role videojuegoBase
    RecursoVideojuego[*] role instanciaUsuario
end

association ReferenciaCancion between
    Cancion[1] role cancionBase
    RecursoCancion[*] role instanciaUsuario
end

association ReferenciaAlbum between
    Album[1] role albumBase
    RecursoAlbum[*] role instanciaUsuario
end

association ReferenciaPelicula between
    Pelicula[1] role peliculaBase
    RecursoPelicula[*] role instanciaUsuario
end

association ReferenciaSerie between
    Serie[1] role serieBase
    RecursoSerie[*] role instanciaUsuario
end

------- Asociaciones del administrador para crear ---------------
association CreaContenido between
	UsuarioAdministrador[1] role creadorRecurso
	Contenido[*] role contenido
end

association ContieneLibro between
	RecursoColeccion[1] role coleccion
	RecursoLibro[*] role libros
end

association ContieneVideojuego between
	RecursoColeccion[1] role coleccion
	RecursoVideojuego[*] role videojuegos
end

association ContieneCancion between
	RecursoColeccion[1] role coleccion
	RecursoCancion[*] role canciones
end

association ContieneAlbum between
	RecursoColeccion[1] role coleccion
	RecursoAlbum[*] role albums
end

association ContienePelicula between
	RecursoColeccion[1] role coleccion
	RecursoPelicula[*] role peliculas
end

association ContieneSerie between
	RecursoColeccion[1] role coleccion
	RecursoSerie[*] role series
end

-- =============================================================================
-- INVARIANTES
-- =============================================================================

constraints 

------- Invariantes de atributos básicos (nada negativo y todos los atributos en rango) ---------

-- Libro: número de páginas positivo
context Libro
inv paginasPositivas: self.paginas > 0

-- Videojuego: duración positiva
context Videojuego
inv duracionPositiva: self.duracion > 0

-- Canción: duración positiva
context Cancion
inv duracionPositiva: self.duracion > 0

-- Película: duración positiva
context Pelicula
inv duracionPositiva: self.duracion > 0

-- Serie: número de temporadas positivo
context Serie
inv temporadasPositivas: self.numeroTemporadas > 0

-- RecursoLibro: horas y páginas no negativas
context RecursoLibro
inv paginasLeidasPositivas: self.paginasLeidas >= 0

inv finalizarLibroConFechaFin: self.fechaFin <> null implies self.estado = TipoEstado::COMPLETADO

-- RecursoVideojuego: horas y dificultad dentro de rango
context RecursoVideojuego
inv horasJugadasPositivas: self.horasJugadas >= 0

inv dificultadValida: self.dificultad >= 1 and self.dificultad <= 10

inv finalizarJuegoConFechaFin: self.fechaFin <> null implies self.estado = TipoEstado::COMPLETADO

-- RecursoPelicula: número de visionados no negativo
context RecursoPelicula
inv numeroVisionadosPositivo: self.numeroVisionados >= 0

-- RecursoSerie: temporada y episodio no negativos
context RecursoSerie
inv temporadaActualPositiva: self.temporadaActual >= 0
inv episodioActualPositivo: self.episodioActual >= 0
inv finalizarSerieConFechaFin: self.fechaFin <> null implies self.estado = TipoEstado::COMPLETADO

-- Recurso: calificación entre 0 y 10 
context Recurso
inv calificacionValida: self.calificacion >= 0 and self.calificacion <= 10

---------------- Invariantes de asociaciones -------------------

-- No duplicados en las colecciones, comparando el conjunto original y convirtiéndolo en set si cambia
context RecursoColeccion
inv noDuplicadosEnLibros: self.libros->asSet() = self.libros
inv noDuplicadosEnVideojuegos: self.videojuegos->asSet() = self.videojuegos
inv noDuplicadosEnCanciones: self.canciones->asSet() = self.canciones
inv noDuplicadosEnAlbums: self.albums->asSet() = self.albums
inv noDuplicadosEnPeliculas: self.peliculas->asSet() = self.peliculas
inv noDuplicadosEnSeries: self.series->asSet() = self.series


------- Asociaciones del administrador para crear ---------

-- Solo los administradores crean recursos
context UsuarioAdministrador
inv creaSoloAdmin:
    self.contenido->forAll(c | c.creadorRecurso = self)



--------- Invariante SOLO puedo meter recurso en colección si es compatible con mi recurso --------------
	--- GRUPO LIBRO: Libro | GRUPO VIDEOJUEGO: Videojuego | GRUPO MUSICA: Cancion, Album | GRUPO TELEVISION: Serie, Pelicula

context RecursoColeccion
inv recursosCompatibles:
    let recursos : Set(Recurso) =
        self.libros
        ->union(self.videojuegos)
        ->union(self.canciones)
        ->union(self.albums)
        ->union(self.peliculas)
        ->union(self.series)
    in
        -- Caso 1: la colección es de tipo COLECCION (todo permitido)
        self.tipoRecurso = TipoRecurso::COLECCION
        or 
        
        -- Caso 2: la colección está vacía
        recursos->isEmpty()
        
        -- Caso 3: todos los recursos son del mismo tipo que el primero, por tanto la union es 1
        or recursos.tipoRecurso->asSet()->size() = 1

